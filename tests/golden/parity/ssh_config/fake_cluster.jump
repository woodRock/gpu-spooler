Host *
  BatchMode yes
  StrictHostKeyChecking accept-new
  LogLevel ERROR
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath {CM_DIR}/%C
  ControlPersist 120s
  IdentityFile {HOME}/fake/id_ed25519
  UserKnownHostsFile ~/fake/known_hosts
  IdentitiesOnly yes
  IdentityAgent none
