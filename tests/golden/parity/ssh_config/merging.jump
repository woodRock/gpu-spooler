# Generated by gpu-spooler from {HOME}/.gpu-spooler/hosts.toml. Do not edit.

Host gate
  HostName gate.example
  ControlPersist 12h

Host ts-127-0-0-1
  HostName 127.0.0.1
  User u
  Port 2201
  ProxyJump gate
  ControlPersist 12h

Host ts---1
  HostName ::1
  Port 2202
  ProxyJump ts-127-0-0-1
  ControlPersist 12h

Host ts-gw
  HostName gw.example.org
  ProxyJump ts---1
  ControlPersist 12h

Host ts-gw-2
  HostName gw.other.org
  ProxyJump ts-gw
  ControlPersist 12h

Host x
  HostName x.a.example
  User alice
  ProxyJump ts-gw-2

Host y
  HostName custom.y
  User yuser
  ProxyJump ts-gw-2

Host z
  User bob

Host *
  BatchMode yes
  StrictHostKeyChecking accept-new
  LogLevel ERROR
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath {CM_DIR}/%C
  ControlPersist 10m
